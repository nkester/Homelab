# GitLab HTTP State Backend Credentials for OpenTofu
# Copy this file to .env (which is git-ignored) and populate with your credentials:
#   cp .env.example .env
#   chmod 600 .env

GITLAB_USER="your-gitlab-username"
GITLAB_PROJECT_ID="12345678"
GITLAB_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxx"
STATE_NAME="homelab-bootstrap"
